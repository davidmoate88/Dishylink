# /etc/nftables.d/dishylink-origin.nft — own table, included from
# /etc/nftables.conf. The dashboard on :8080 has no sign-in, so it is reachable
# only from the LAN (IPv4) and loopback; the tailnet reaches it through
# `tailscale serve`, which connects over loopback. Load with `nft -f`, never
# `systemctl restart nftables` (that flushes the whole ruleset).
table inet dishylink_origin
delete table inet dishylink_origin
table inet dishylink_origin {
  chain input {
    type filter hook input priority 0; policy accept;
    iifname "lo" accept
    tcp dport 8080 ip saddr 192.168.1.0/24 accept
    tcp dport 8080 drop
  }
}
