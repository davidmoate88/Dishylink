# Dishylink browser host: the built dashboard, the dish/router proxies and the
# history recorder, in one process. Listens on :8080 with no sign-in, so it is
# kept to the LAN (origin.nft) — the same reach the dish and router already
# give the LAN — and the tailnet, via tailscale serve.
[Unit]
Description=Dishylink dashboard and history recorder
After=network-online.target
Wants=network-online.target

[Service]
User=dishylink
Group=dishylink
WorkingDirectory=/opt/dishylink
EnvironmentFile=/etc/dishylink/dishylink.env
# Secrets (the ntfy token), mode 600; optional.
EnvironmentFile=-/etc/dishylink/ntfy.env
ExecStart=/usr/bin/node --import tsx docker/browserHost.mts
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dishylink

[Install]
WantedBy=multi-user.target
