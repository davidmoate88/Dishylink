# /etc/dishylink/dishylink.env — no secrets here.
HISTORIAN_EMBED=1
HISTORIAN_DATA_DIR=/var/lib/dishylink
HISTORIAN_PROTOSET=/opt/dishylink/public/dish.protoset
STARLINK_COOKIE_FILE=/var/lib/dishylink/.starlink-cookie
BROWSER_DIST=/opt/dishylink/dist
BROWSER_HOST_PORT=8080
NODE_ENV=production
# Reached on the LAN and over the tailnet (tailscale serve, *.ts.net), both of
# which already count as local. Only a public origin behind a sign-in proxy
# would need listing here:
# DISHYLINK_TRUSTED_ORIGINS=https://dishy.example.com
# Home dashboards allowed to frame embed.html (space-separated sources).
FRAME_ANCESTORS=http://192.168.1.10:8000
